# Supabase
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Storage bucket name used for payment screenshots
VITE_SUPABASE_PAYMENTS_BUCKET=payment-screenshots

# App
VITE_APP_NAME="ملعب الوطن"

# How long a booking hold/lock is valid for, in minutes.
# Kept as an env var so it can be tuned without a code change.
VITE_RESERVATION_LOCK_MINUTES=5
